#!/usr/bin/env python3
import socket
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

def check_open_port(port):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.04)
        res = s.connect_ex(("127.0.0.1", port))
        s.close()
        if res == 0:
            return port
    except Exception:
        pass
    return None

def test_connect(port):
    try:
        proc = subprocess.run(["adb", "connect", f"127.0.0.1:{port}"], capture_output=True, text=True, timeout=1.5)
        if "connected to" in proc.stdout.lower() and "failed" not in proc.stdout.lower():
            return port
    except Exception:
        pass
    return None

def main():
    # 1. Clean existing offline devices
    try:
        out = subprocess.check_output(["adb", "devices"], text=True, timeout=2)
        lines = [line.strip().split() for line in out.strip().split("\n")[1:] if line.strip()]
        for dev, state in lines:
            if state == "device":
                print(f"✓ ADB already connected: {dev}")
                return 0
            elif state == "offline":
                subprocess.run(["adb", "disconnect", dev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    print("⚡ Scanning active ports for ADB Wireless Debugging...")
    ports = [5555] + list(range(35000, 48000)) + list(range(30000, 35000))
    open_candidates = []
    
    with ThreadPoolExecutor(max_workers=150) as executor:
        for p in executor.map(check_open_port, ports):
            if p:
                open_candidates.append(p)

    if not open_candidates:
        print("✗ Tidak ada port yang terbuka. Pastikan 'Wireless Debugging' aktif.")
        return 1

    for p in open_candidates:
        if test_connect(p):
            # Check devices
            devs = subprocess.run(["adb", "devices"], capture_output=True, text=True).stdout
            if f"127.0.0.1:{p}\tdevice" in devs:
                print(f"🚀 ADB successfully connected to 127.0.0.1:{p}!")
                return 0

    print("✗ Gagal menyambungkan ke port kandidat.")
    return 1

if __name__ == "__main__":
    sys.exit(main())
